echo "$CODEGEN_DEPS" >> "$tmp"
echo "" >> "$tmp"
echo "func queryValidates(m *sql.QueryManager) []func() error {" >> "$tmp"
echo "return []func() error{" >> "$tmp"
echo "$code" >> "$tmp"
