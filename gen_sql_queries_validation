#!/usr/bin/env python3

import logging
import subprocess as sp
import sys
from pathlib import Path



CODEGEN_FILE_HEADER = '// THIS CODE IS GENERATED - DO NOT CHANGE IT'
CODEGEN_DEPS = '''
