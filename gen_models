#!/usr/bin/env python3
import argparse
import subprocess as sp
from pathlib import Path

import gen_models_lib
from gen_models_lib import handle_api_file, handle_definitions_file, ProgrammingLanguage, get_out_fp, GENERATED_OUT_FILES


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument('input_file', type=str)
    parser.add_argument('output_dir', type=str)
    parser.add_argument('-v', '--volume', type=str, nargs='*', action='extend', help='Volumes in format `dir:dir` that are used to control where openapi file definition will be generated')
    parser.add_argument('-e', '--extra', type=str, nargs='*', action='extend', help='Force openapi file to be processed even when it\'s not used by api')
    parser.add_argument('--output-basename-suffix', type=str, help='Customize suffix for names of generated files')
    return parser.parse_args()


def main():
    args = parse_args()
    input_file = Path(args.input_file)
    output_dir = Path(args.output_dir)
    assert input_file.is_file()
    assert output_dir.is_dir()
    
    if args.volume is not None:
        volumes = []
        for v in args.volume:
            src, dst = v.split(':')
            src = Path.cwd() / src
            dst = Path.cwd() / dst
            volumes.append((src, dst))
        gen_models_lib.VOLUMES = volumes + gen_models_lib.VOLUMES
    if args.output_basename_suffix is not None:
        gen_models_lib.CODEGEN_FILE_NAME_SUFFIX = args.output_basename_suffix
    handle_api_file(input_file.absolute(), output_dir.absolute(), ProgrammingLanguage.Golang)
    if args.extra is not None and len(args.extra) > 0:
        for additional_input_file in args.extra:
            p = Path(additional_input_file)
            assert p.is_file()
            fp = p.absolute()
            handle_definitions_file(fp, get_out_fp(fp), ProgrammingLanguage.Golang)

    sp.run(['gofmt', '-s', '-w', output_dir.absolute()])
    sp.run(['goimports', '-w', output_dir.absolute()])
    
    codegen_dirs = set(f.parent for f in GENERATED_OUT_FILES)
    for d in codegen_dirs:
        sp.run(['gofmt', '-s', '-w', d.absolute()])
        sp.run(['goimports', '-w', d.absolute()])

if __name__ == '__main__':
    main()

